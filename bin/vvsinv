#!/bin/bash
# SYS.VVS — inventering av VVS-verkstaden.
#
#   vvsinv              öppna appen
#   vvsinv --omstart    starta om servern så att ändrad kod laddas (lokal)
#   vvsinv --qr         skriv ut telefonadressen och en QR-kod i terminalen
#   vvsinv --nyckel     visa nyckeln (klistras in i Render under VVS_TOKEN)
#   vvsinv --lokal      kör den lokala servern även om molnet är valt
#
# Är "moln" ifyllt i config.json (t.ex. https://sysvvs-inventering.onrender.com)
# öppnar vvsinv den adressen i stället för att starta en egen server. Då finns
# det bara *en* inventering: den på serverns disk. Telefonen och datorn ser
# samma lista, och datorn behöver inte vara på. Den lokala servern finns kvar
# och nås med --lokal när man vill köra utan nät.
#
# Var appen ligger hittas på tre sätt, i tur och ordning:
#   1. miljövariabeln VVS_MAPP
#   2. mappen skriptet självt ligger i, om server.py ligger där
#   3. ~/vvs-inventering
# Inga sökvägar är hårdkodade, så samma fil fungerar på vilken maskin som helst.

set -u

# Loggen och de sparade filerna kan innehålla telefonlänken, och länken är
# nyckeln. Därför skapas de så att bara du själv kan läsa dem (600/700).
umask 077

PORT="${VVS_PORT:-8792}"
PROFIL="${VVS_PROFIL:-$HOME/.mozilla/firefox/sysvvs.inv}"
TITEL="SYS.VVS ‖ inventering"

hitta_mapp() {
    if [ -n "${VVS_MAPP:-}" ] && [ -f "$VVS_MAPP/server.py" ]; then
        printf '%s' "$VVS_MAPP"; return 0
    fi
    # installera.sh lägger en *länk* i ~/.local/bin. Följ den till den riktiga
    # filen — annars letar vi i ~/.local/bin och hittar ingenting.
    local har
    har="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
    har="$(cd "$(dirname "$har")" 2>/dev/null && pwd)" || true
    if [ -n "$har" ] && [ -f "$har/server.py" ]; then printf '%s' "$har"; return 0; fi
    if [ -n "$har" ] && [ -f "$har/../server.py" ]; then (cd "$har/.." && pwd); return 0; fi
    if [ -f "$HOME/vvs-inventering/server.py" ]; then
        printf '%s' "$HOME/vvs-inventering"; return 0
    fi
    return 1
}

MAPP="$(hitta_mapp)" || {
    echo "vvsinv: hittar inte server.py. Sätt VVS_MAPP till mappen med appen." >&2
    exit 1
}
SERVER="$MAPP/server.py"
KONFIG="$MAPP/config.json"
URL="http://127.0.0.1:${PORT}"

if ! command -v python3 >/dev/null 2>&1; then
    echo "vvsinv: python3 saknas. Installera med:  sudo apt install python3" >&2
    exit 1
fi

OMSTART=0; QR=0; NYCKEL=0; LOKAL=0
for arg in "$@"; do
    case "$arg" in
        --omstart|omstart) OMSTART=1 ;;
        --qr|qr)           QR=1 ;;
        --nyckel|nyckel)   NYCKEL=1 ;;
        --lokal|lokal)     LOKAL=1 ;;
    esac
done

las_token() {
    python3 -c "
import json
try: print(json.load(open('$KONFIG')).get('token',''))
except Exception: print('')" 2>/dev/null
}

# Molnadressen: ur miljön om den finns, annars ur config.json. Tom = kör lokalt.
las_moln() {
    if [ -n "${VVS_MOLN:-}" ]; then printf '%s' "$VVS_MOLN"; return 0; fi
    python3 -c "
import json
try: print(json.load(open('$KONFIG')).get('moln','') or '')
except Exception: print('')" 2>/dev/null
}

# Gör om 'host' eller 'https://host/' till en ren bas utan avslutande snedstreck.
rena_adress() {
    local a="$1"
    case "$a" in http://*|https://*) ;; *) a="https://$a" ;; esac
    printf '%s' "${a%/}"
}

# --nyckel skriver bara ut nyckeln, så att den kan klistras in i Render
# (Environment -> VVS_TOKEN). Servern behöver inte vara igång för det, och
# nyckeln syns bara på din egen skärm — ingenting hamnar i någon logg.
if [ "$NYCKEL" = 1 ]; then
    TOKEN="$(las_token)"
    if [ -z "$TOKEN" ]; then
        echo "vvsinv: ingen nyckel i $KONFIG. Starta appen en gång först." >&2
        exit 1
    fi
    echo "Nyckeln till SYS.VVS — klistra in den i Render under VVS_TOKEN:"
    echo
    echo "  $TOKEN"
    echo
    echo "Telefonen behöver inget: den får nyckeln via QR-koden i Kalkyl."
    exit 0
fi

# --- molnet: en enda sanning -------------------------------------------------
# Är en molnadress vald öppnar vi den i stället för att starta en egen server.
# Då finns bara en inventering — den på serverns disk — och datorn behöver
# inte vara på. Ingen lokal bildmodell laddas i onödan. --lokal (eller
# --omstart, som bara gäller en lokal server) går förbi molnet.
MOLN=""
[ "$LOKAL" = 1 ] || MOLN="$(las_moln)"
if [ -n "$MOLN" ] && [ "$OMSTART" != 1 ]; then
    MOLN="$(rena_adress "$MOLN")"
    TOKEN="$(las_token)"
    CLOUD="$MOLN"
    [ -n "$TOKEN" ] && CLOUD="$MOLN/?t=$TOKEN"
    echo "SYS.VVS — molnet. Inventeringen ligger på servern, inte här."
    echo "  adress : $MOLN"
    if [ -z "$TOKEN" ]; then
        echo "  varning: ingen nyckel i $KONFIG — sidan frågar efter den." >&2
    fi
    if [ "$QR" = 1 ]; then
        if command -v qrencode >/dev/null 2>&1 && [ -n "$TOKEN" ]; then
            qrencode -t ANSIUTF8 "$CLOUD" 2>/dev/null || true
            echo
        fi
        echo "Skanna koden, eller öppna $MOLN i telefonens webbläsare."
        echo "Nyckeln följer med i länken — samma nyckel som i Render."
        exit 0
    fi
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -i sysvvs "SYS.VVS" "Öppnar molnet:\n$MOLN" 2>/dev/null || true
    if [ -x "$HOME/.local/bin/sysappfonster" ]; then
        exec "$HOME/.local/bin/sysappfonster" "$PROFIL" "$CLOUD" "$TITEL"
    fi
    if command -v xdg-open >/dev/null 2>&1; then
        exec xdg-open "$CLOUD"
    fi
    echo "Öppna $CLOUD i webbläsaren."
    exit 0
fi

mkdir -p "$MAPP/data/bilder" "$MAPP/data/export"

port_oppen() { (exec 3<>/dev/tcp/127.0.0.1/"$PORT") 2>/dev/null; }
port_pid()   { ss -ltnpH "sport = :${PORT}" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2; }

lan_ip() {
    python3 - <<'PY' 2>/dev/null || echo "127.0.0.1"
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("10.255.255.255", 1)); print(s.getsockname()[0])
except Exception:
    print("127.0.0.1")
finally:
    s.close()
PY
}

# 1) servern
if [ "$OMSTART" = 1 ] && port_oppen; then
    gammal="$(port_pid)"
    if [ -n "$gammal" ]; then
        kill "$gammal" 2>/dev/null
        for _ in $(seq 1 40); do port_oppen || break; sleep 0.25; done
        port_oppen && { echo "vvsinv: porten $PORT är fortfarande upptagen (pid $gammal)" >&2; exit 1; }
    fi
fi

if ! port_oppen; then
    setsid python3 -u "$SERVER" >>"$MAPP/data/server.log" 2>&1 </dev/null &
    for _ in $(seq 1 60); do port_oppen && break; sleep 0.25; done
    if ! port_oppen; then
        echo "vvsinv: servern startade inte. Se $MAPP/data/server.log" >&2
        exit 1
    fi
fi

# 2) telefonadressen
TOKEN="$(las_token)"
MOBIL="http://$(lan_ip):${PORT}"
[ -n "$TOKEN" ] && MOBIL="$MOBIL/?t=$TOKEN"

echo "SYS.VVS kör"
echo "  datorn : $URL"
echo "  mobil  : $MOBIL"
if command -v qrencode >/dev/null 2>&1 && [ -n "$TOKEN" ]; then
    echo
    qrencode -t ANSIUTF8 "$MOBIL" 2>/dev/null || true
fi
command -v notify-send >/dev/null 2>&1 && \
    notify-send -i sysvvs "SYS.VVS" "Öppna på telefonen:\n$MOBIL" 2>/dev/null || true

if [ "$QR" = 1 ]; then
    echo
    echo "Skanna koden ovan, eller skriv in adressen i telefonens webbläsare."
    exit 0
fi

# 3) fönstret
if [ -x "$HOME/.local/bin/sysappfonster" ]; then
    exec "$HOME/.local/bin/sysappfonster" "$PROFIL" "$URL" "$TITEL"
fi
if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$URL"
fi
echo "Öppna $URL i webbläsaren."
