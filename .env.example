# Kopia av den här filen, ifylld, kallas .env lokalt.
# På Render lägger du i stället in raderna under Environment.
# .env får ALDRIG checkas in — den innehåller hemligheter.

# ---- Servern ----
# Render sätter PORT själv. Lokalt är 8792 standard.
#PORT=10000

# Token som telefonen använder. Utan den nekar servern allt utifrån.
# Appen skapar en egen om den här raden saknas.
VVS_TOKEN=byt-till-en-egen-lang-slumpad-strang

# Kräv token även från 127.0.0.1. MÅSTE vara 1 på en server — bakom
# plattformens proxy ser annars alla besök ut att komma från localhost,
# och då stängs autentiseringen av utan att någon märker det.
VVS_KRAV_TOKEN=1

# ---- Var datan ligger (endast server) ----
# Render monterar disken på /var/data. Utan detta försvinner inventeringen
# vid varje omstart.
VVS_DATA=/var/data
VVS_CONFIG=/var/data/config.json

# ---- Bildanalys i molnet ----
# Render kan inte köra Ollama. Ange en leverantör och en nyckel i stället.
# Leverantör: gemini eller openai
VVS_AI_LEVERANTOR=gemini
VVS_AI_NYCKEL=din-api-nyckel
#VVS_AI_MODELL=gemini-2.0-flash

# ---- Skolan (frivilligt, går också att fylla i i appen) ----
#VVS_SKOLA=Praktiska Uppsala
#VVS_PROGRAM=VVS
#VVS_ANSVARIG=
#VVS_DEADLINE=2026-10-20

# ---- E-post (frivilligt, för att kunna mejla kalkylarket) ----
#VVS_MEJL_ADRESS=du@skola.se
#VVS_MEJL_NAMN=Ditt Namn
#VVS_MEJL_SMTP_SERVER=smtp.gmail.com
#VVS_MEJL_SMTP_PORT=465
#VVS_MEJL_LOSENORD=applosendord
